<%= simple_form_for [@ai_chat.dog, @ai_chat, ai_message],
    data: { turbo: true } do |f| %>
  <div class="input-group">
    <%= f.input :content,
        label: false,
        placeholder: "Pose une question sur ton chien...",
        required: true,
        wrapper: false,
        input_html: { class: "form-control rounded-start-pill" } %>
    <%= f.button :submit, class: "btn btn-primary rounded-end-pill px-4" do %>
      Envoyer <i class="fa-solid fa-paper-plane ms-1"></i>
    <% end %>
  </div>
<% end %>
