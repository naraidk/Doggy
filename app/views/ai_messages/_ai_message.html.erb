<% if ai_message.role == "user" %>
  <div class="d-flex justify-content-end">
    <div class="bg-primary text-white px-3 py-2 rounded-4" style="max-width: 75%;">
      <%= ai_message.content %>
    </div>
  </div>
<% elsif ai_message.role == "assistant" %>
  <div class="d-flex justify-content-start">
    <div class="d-flex align-items-start gap-2" style="max-width: 75%;">
      <span class="fs-4">🐾</span>
      <div class="bg-light px-3 py-2 rounded-4">
        <%= ai_message.content %>
      </div>
    </div>
  </div>
<% end %>
