<div class="card border-light rounded-6 shadow-sm mb-3 mx-3" style="background-color: #f8f9fa;">

  <% content_for :title, "Carte" %>

  <div class="map-page pb-5"
       data-controller="map"
       data-map-events-value="<%= @events_json %>"
       data-map-token-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>">
    <div class="map-header px-3 pt-3 pb-2">
      <h5 class="fw-bold mb-0">Carte</h5>
      <p class="text-muted small mb-0">Trouvez des chiens et événements près de chez vous</p>
    </div>
    <div class="map-search px-3 pb-2" data-map-target="geocoder"></div>
    <div id="map" data-map-target="container"></div>
  </div>
</div>

<%= link_to events_path, class: "btn-floating-map" do %>
  <i class="fa-solid fa-list"></i>
<% end %>
