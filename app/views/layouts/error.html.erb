<!DOCTYPE html>
<html>
  <head>
    <title>Doggy</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      :root {
        --bg-light: #fff8f1;
        --bg-dark: #171210;
        --surface-light: rgba(255,255,255,0.78);
        --surface-dark: rgba(35,28,25,0.82);
        --text-light: #2f241f;
        --text-dark: #fff5ef;
        --muted-light: #7d6d66;
        --muted-dark: #cebdb5;
        --line-light: rgba(73,49,38,0.10);
        --line-dark: rgba(255,255,255,0.08);
        --primary: #ff7a59;
        --primary-strong: #e85d3d;
        --secondary: #7b5cff;
        --danger: #ff5d73;
        --accent: #ffd166;
        --radius: 28px;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .error-page {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .error-page--404 {
        color: var(--text-light);
        background:
          radial-gradient(circle at top left, rgba(255, 122, 89, 0.16), transparent 30%),
          radial-gradient(circle at bottom right, rgba(123, 92, 255, 0.14), transparent 28%),
          linear-gradient(180deg, #fffaf4 0%, #fff3e8 100%);
      }

      .error-page--500 {
        color: var(--text-dark);
        background:
          radial-gradient(circle at top left, rgba(255, 93, 115, 0.18), transparent 28%),
          radial-gradient(circle at bottom right, rgba(143, 124, 255, 0.16), transparent 26%),
          linear-gradient(180deg, #18110f 0%, #110d0c 100%);
      }

      .error-shell {
        width: min(1080px, 100%);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
        align-items: center;
      }

      .error-panel {
        padding: 40px;
        border-radius: var(--radius);
        backdrop-filter: blur(14px);
      }

      .error-page--404 .error-panel {
        background: var(--surface-light);
        border: 1px solid var(--line-light);
        box-shadow: 0 24px 60px rgba(72, 42, 30, 0.14);
      }

      .error-page--500 .error-panel {
        background: var(--surface-dark);
        border: 1px solid var(--line-dark);
        box-shadow: 0 30px 70px rgba(0,0,0,0.36);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 999px;
        margin-bottom: 22px;
        font-size: 14px;
      }

      .error-page--404 .brand {
        background: rgba(255,255,255,0.75);
        border: 1px solid var(--line-light);
        color: var(--muted-light);
      }

      .error-page--500 .brand {
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--line-dark);
        color: var(--muted-dark);
      }

      .logo {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: #fff;
        font-size: 18px;
        background: linear-gradient(135deg, var(--primary), #ff936d);
      }

      .error-title {
        margin: 0 0 16px;
        font-size: clamp(42px, 8vw, 84px);
        line-height: .94;
        letter-spacing: -0.045em;
      }

      .error-text {
        margin: 0 0 28px;
        font-size: clamp(17px, 2vw, 20px);
        line-height: 1.65;
        max-width: 28ch;
      }

      .error-page--404 .error-text,
      .error-page--404 .error-note { color: var(--muted-light); }

      .error-page--500 .error-text,
      .error-page--500 .error-note { color: var(--muted-dark); }

      .error-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 18px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 700;
        transition: transform .18s ease, box-shadow .18s ease;
      }

      .btn:hover { transform: translateY(-1px); }

      .btn-primary {
        background: linear-gradient(135deg, var(--primary), #ff936d);
        color: #fff;
        box-shadow: 0 14px 24px rgba(255, 122, 89, 0.24);
      }

      .btn-dark {
        background: linear-gradient(135deg, var(--primary-strong), var(--danger));
        color: #fff;
        box-shadow: 0 16px 28px rgba(255, 93, 115, 0.18);
      }

      .btn-secondary {
        border: 1px solid transparent;
      }

      .error-page--404 .btn-secondary {
        background: rgba(255,255,255,.78);
        color: var(--text-light);
        border-color: var(--line-light);
      }

      .error-page--500 .btn-secondary {
        background: rgba(255,255,255,.04);
        color: var(--text-dark);
        border-color: var(--line-dark);
      }

      .visual-card {
        border-radius: 30px;
        padding: 28px;
      }

      .error-page--404 .visual-card {
        background: #ffffff;
        border: 1px solid rgba(73, 49, 38, 0.08);
        box-shadow: 0 26px 60px rgba(66, 39, 28, 0.15);
      }

      .error-page--500 .visual-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        box-shadow: 0 26px 60px rgba(0,0,0,0.30);
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      .error-page--404 .badge {
        background: #fff3eb;
        color: var(--primary-strong);
      }

      .error-page--500 .badge {
        background: rgba(255, 93, 115, 0.12);
        color: #ff9fb1;
      }

      .visual-title {
        margin: 0 0 12px;
        font-size: clamp(56px, 10vw, 120px);
        line-height: .9;
        letter-spacing: -0.06em;
      }

      .error-page--500 .visual-title {
        background: linear-gradient(135deg, #fff5ef, #ffb09c);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .visual-text {
        margin: 0 0 22px;
        line-height: 1.6;
      }

      .status-box {
        padding: 16px;
        border-radius: 20px;
      }

      .error-page--404 .status-box {
        background: #fff8f3;
        border: 1px solid rgba(73, 49, 38, 0.07);
        color: var(--muted-light);
      }

      .error-page--500 .status-box {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        color: var(--muted-dark);
      }

      .mini-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 16px;
      }

      .mini-item {
        padding: 12px;
        text-align: center;
        border-radius: 16px;
        font-size: 13px;
      }

      .error-page--404 .mini-item {
        background: #fff8f3;
        border: 1px solid rgba(73, 49, 38, 0.07);
        color: var(--muted-light);
      }

      .error-page--500 .mini-item {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.05);
        color: var(--muted-dark);
      }

      @media (max-width: 920px) {
        .error-shell { grid-template-columns: 1fr; }
        .error-panel, .visual-card { padding: 28px; }
        .error-text, .visual-text { max-width: 100%; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
