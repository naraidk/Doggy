<% @events.each do |event| %>

<div class="card border-light rounded-6 shadow-sm mb-3 mx-3" style="background-color: #f8f9fa;">

  <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <div class="d-flex align-items-center" style="min-width: 0;">
      <%= link_to event.title, event_path(event), class: "fw-bold text-black", style: "text-decoration: none;" %>

    </div>

    <div class="badge text-doggy">
     <%= event.event_participants.count %> participant(s)
    </div>

  </div>

  <div class="border-top border-light-subtle bg-white rounded-bottom-6 px-4 py-2">

    <%= link_to "#", class: "d-flex justify-content-between align-items-center py-2.5 border-bottom border-light-subtle text-decoration-none" do %>
      <h6 class="mb-0 text-dark fw-normal py-2" style="font-size: 0.95rem;">Modifier mon nom</h6>
    <% end %>

     <%= link_to "#", class: "d-flex justify-content-between align-items-center py-2.5 border-bottom border-light-subtle text-decoration-none" do %>
      <h6 class="mb-0 text-dark fw-normal py-2" style="font-size: 0.95rem;">Modifier mon email</h6>
    <% end %>

     <%= link_to new_user_password_path, class: "d-flex justify-content-between align-items-center py-2.5 text-decoration-none" do %>
      <h6 class="mb-0 text-dark fw-normal py-2" style="font-size: 0.95rem;">Modifier mon mot de passe</h6>
    <% end %>

  </div>

</div>
<% end %>

<%= link_to map_path, class: "btn-floating-map" do %>
  <i class="fa-solid fa-map"></i>
<% end %>
