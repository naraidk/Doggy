<% @events.each do |event| %>

<div class="card border-light rounded-6 shadow-sm mb-3 mx-3" style="background-color: #f8f9fa;">

  <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <div style="min-width: 0;">
      <%= link_to event.title, event_path(event), class: "fw-bold text-black d-block mb-1", style: "text-decoration: none;" %>

      <div class="d-flex align-items-center gap-2">
        <span class="text-muted" style="font-size: 0.85rem;">Organisé par :</span>
        <%= link_to dog_path(event.dog), class: "d-flex align-items-center gap-1 text-decoration-none" do %>
          <% if event.dog.avatar.attached? %>
            <%= cl_image_tag event.dog.avatar.key,
                  transformation: [{ width: 28, height: 28, crop: "thumb", gravity: "face", quality: "auto" }],
                  class: "rounded-circle object-fit-cover flex-shrink-0",
                  style: "width: 28px; height: 28px; border: 2px solid #f86120;" %>
          <% else %>
            <%= image_tag "dogs_pic.jpg",
                  class: "rounded-circle object-fit-cover flex-shrink-0",
                  style: "width: 28px; height: 28px;" %>
          <% end %>
          <strong class="text-doggy" style="font-size: 0.85rem;"><%= event.dog.name %></strong>
        <% end %>
      </div>
    </div>

    <div class="badge text-doggy">
     <%= event.event_participants.count %> participant(s)
    </div>

  </div>

  <div class="border-top border-light-subtle bg-white rounded-bottom-6 px-4 py-2">
    <% if event.dog.user == current_user %>
      <%= link_to edit_event_path(event), class: "d-flex justify-content-between align-items-center py-2 text-decoration-none" do %>
        <h6 class="mb-0 text-dark fw-normal py-2" style="font-size: 0.95rem;">Modifier l'événement</h6>
        <i class="fa-solid fa-chevron-right text-muted" style="font-size: 0.8rem;"></i>
      <% end %>
    <% end %>
  </div>

</div>
<% end %>

<%= link_to map_path, class: "btn-floating-map" do %>
  <i class="fa-solid fa-map"></i>
<% end %>
