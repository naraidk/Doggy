<div class="container py-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Événements canins</h1>

    <%= link_to "Créer un événement", new_event_path, class: "btn btn-primary" %>
  </div>

  <% @events.each do |event| %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <h4>
          <%= link_to event.title, event_path(event), class: "text-decoration-none" %>
        </h4>

        <p class="text-muted mb-1"> <%= event.city %></p>
        <p class="text-muted mb-1"><%= event.date.strftime("%d/%m/%Y à %H:%M") %></p>
        <p class="mb-1"> Organisé par <strong><%= event.dog.name %></strong></p>

        <span class="badge bg-primary">
          <%= event.event_participants.count %> participant(s)
        </span>
      </div>
    </div>
  <% end %>
</div>
