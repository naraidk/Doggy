<div class="card border-light rounded-6 shadow-sm mb-3 mx-3" style="background-color: #white;">

  <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <div class="d-flex align-items-center" style="min-width: 0;">
      <div>
        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem; letter-spacing: -0.3px;"><%= @event.title %></h5>
      </div>
    </div>
    <div>
      <% already_joined = @event.dogs.where(id: current_user.dogs.ids).exists? %>

      <% if already_joined %>
         <%= button_to "Se désinscrire",
          event_event_participant_path(@event, @existing_participant),
          method: :delete,
          form: {data: { turbo: false }},
          class: "btn btn-danger-doggy text-white rounded-4" %>
      <% else %>
      <%= button_to "Participer",
          event_event_participants_path(@event),
          method: :post,
          form: {data: { turbo: false }},
          class: "btn btn-doggy text-white rounded-4" %>
      <% end %>
    </div>

  </div>

 <div class="border-top border-light-subtle bg-white rounded-bottom-6 px-4 py-2 event-details-list">

  <p class="text-dark d-flex align-items-center gap-2 mb-2 py-1">
    <%= image_tag "calendar.svg", class: "svg-icon-list", alt: "Localisation" %>
    <span>Cet événement a lieu à <strong class="text-doggy"><%= @event.city %></strong></span>
  </p>

  <p class="text-dark d-flex align-items-center gap-2 mb-2 py-1">
    <%= image_tag "calendar.svg", class: "svg-icon-list", alt: "Date" %>
    <span><%= @event.date.strftime("%d/%m/%Y à %H:%M") %></span>
  </p>

  <p class="text-dark d-flex align-items-center gap-2 mb-0 py-1">
    <%= image_tag "calendar.svg", class: "svg-icon-list", alt: "Organisateur" %>
    <span>Organisé par
      <%= link_to dog_path(@event.dog), class: "d-inline-flex align-items-center gap-2 text-decoration-none" do %>
        <% if @event.dog.avatar.attached? %>
          <%= cl_image_tag @event.dog.avatar.key,
                transformation: [{ width: 32, height: 32, crop: "thumb", gravity: "face", quality: "auto" }],
                class: "rounded-circle object-fit-cover",
                style: "width: 32px; height: 32px; border: 2px solid #f86120;" %>
        <% else %>
          <%= image_tag "dogs_pic.jpg",
                class: "rounded-circle object-fit-cover",
                style: "width: 32px; height: 32px;" %>
        <% end %>
        <strong class="text-doggy"><%= @event.dog.name %></strong>
      <% end %>
    </span>
  </p>

</div>

      <div class="px-4 fs-6 fst-italic mb-0 text-dark" style="font-size: 1.1rem; letter-spacing: -0.3px;">
            <p><%= @event.description %></p>
      </div>

      <div class="border-top border-light-subtle bg-white rounded-bottom-6 px-4 py-2">
        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem; letter-spacing: -0.3px;">Qui participe ?</h5>

    <% if @event.event_participants.any? %>
      <% @event.event_participants.each do |participant| %>
        <div class="d-flex align-items-center gap-2 py-2">
          <% if participant.dog.avatar.attached? %>
            <%= cl_image_tag participant.dog.avatar.key,
                  transformation: [{ width: 32, height: 32, crop: "thumb", gravity: "face", quality: "auto" }],
                  class: "rounded-circle object-fit-cover",
                  style: "width: 32px; height: 32px; border: 2px solid #f86120;" %>
          <% else %>
            <%= image_tag "dogs_pic.jpg", class: "rounded-circle object-fit-cover", style: "width: 32px; height: 32px;" %>
          <% end %>
          <%= link_to participant.dog.name, dog_path(participant.dog), class: "text-dark text-decoration-none fw-normal", style: "font-size: 0.95rem;" %>
        </div>
      <% end %>
    <% else %>
      <h6 class="mb-0 text-dark fw-normal py-2" style="font-size: 0.95rem;">Aucun participant pour le moment.</h6>
    <% end %>

</div>
</div>
  <%= link_to events_path, class: "btn-floating-map" do %>
  <i class="fa-solid fa-list"></i>
<% end %>

<div id="map"
     data-controller="map"
     data-map-events-value="<%= [@event].to_json %>"
     data-map-token-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>"
     data-map-icon-url-value="<%= image_path('doggy_loc.svg') %>"
     data-map-target="container"
     style="width: 100%; height: 300px; border-radius: 12px;"
     class="my-3">
    </div>

    <div class="d-flex justify-content-center p-2">
      <%= button_to "Supprimer l'événement",
              event_path(@event),
              method: :delete,
              data: {
                  turbo_confirm: "Supprimer cet événement ?"
                },
              class: "btn text-doggy rounded-4" %>
    </div>


