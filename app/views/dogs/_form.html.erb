<div class="card border-light rounded-6 shadow-sm mb-3 mx-3">
  <div class="container d-flex align-items-center justify-content-center">

    <div class="border-light rounded-6">
      <div class="container d-flex justify-content-center pb-4">
    </div>
        <%= simple_form_for dog, html: { multipart: true } do |f| %>

  <%= f.input :name,
              label: "Nom du chien",
              wrapper_html: { class: "mb-3" },
              input_html: { class: "form-control-lg bg-white border-doggy shadow-sm" } %>

  <%= f.input :breed,
            label: "Race",
            collection: ["Berger Australien", "Golden Retriever", "Labrador Retriever", "Bouledogue Français", "Teckel", "Chihuahua", "Shiba Inu", "Border Collie", "Husky Sibérien", "Cavalier King Charles", "Beagle", "Jack Russell Terrier", "Yorkshire Terrier", "Boxer", "Dalmatien", "Rottweiler", "Schnauzer", "Cocker Spaniel", "Bichon Frisé", "Mastiff"],
            prompt: "Choisir une race" %>

  <%= f.input :gender,
              label: "Sexe",
              collection: ["Mâle", "Femelle"],
              prompt: "Choisir un sexe" %>

  <%= f.input :age,
              label: "Âge",
              collection: (1..25),
              prompt: "Choisir un âge" %>

  <%= f.input :size,
            label: "Taille",
            collection: ["Petit", "Moyen", "Grand"],
            prompt: "Choisir une taille" %>

<%= f.input :energy_level,
            label: "Niveau d'énergie",
            collection: ["Très calme", "Calme", "Équilibré", "Dynamique", "Très dynamique"],
            prompt: "Choisir un niveau" %>

<%= f.input :canine_sociability,
            label: "Sociabilité canine",
            collection: ["Très réservé", "Sélectif", "Sociable", "Très sociable", "Adore tous les chiens"],
            prompt: "Choisir une sociabilité" %>

<%= f.input :human_sociability,
            label: "Sociabilité humaine",
            collection: ["Méfiant", "Réservé", "Amical", "Très affectueux", "Adore les humains"],
            prompt: "Choisir une sociabilité" %>

<%= f.input :temperament,
            label: "Tempérament",
            collection: ["Joueur", "Protecteur", "Aventurier", "Affectueux", "Indépendant"],
            prompt: "Choisir un tempérament" %>

<%= f.input :favorite_activity,
            label: "Activité favorite",
            collection: ["Promenade tranquille", "Jeux", "Course", "Randonnée", "Baignade"],
            prompt: "Choisir une activité" %>

  <%= f.input :description,
              as: :text,
              label: "Description",
              wrapper_html: { class: "mb-4" },
              input_html: { rows: 4, class: "form-control-lg bg-white border-doggy shadow-sm" } %>

  <%= f.input :avatar,
              as: :file,
              label: "Photo de profil",
              wrapper_html: { class: "mb-4" },
              input_html: { class: "form-control-lg bg-white border-doggy shadow-sm" } %>
  <div class="form-actions d-flex justify-content-center">
  <%= f.button :submit, "Enregistrer",
               class: "d-flex rounded btn btn-orange justify-content-center rounded-4 px-4" %>
  </div>

<% end %>

  </div>

  </div>
</div>
