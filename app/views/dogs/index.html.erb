
<!-- User profile -->
<div class="card border-light rounded-6 shadow-sm mb-3 mx-3">
  <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <div class="d-flex align-items-center" style="min-width: 0;">

      <!-- User Profile -->
       <%= image_tag "user.svg",
        class: "rounded-circle me-3",
        style: "width: 56px; height: 56px; flex-shrink: 0; background-color: #eee; padding: 8px; object-fit: contain;" %>


      <!-- user info -->
      <div>
        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem; letter-spacing: -0.3px;">
          <%= [current_user.first_name, current_user.last_name].compact.join(" ") %>
        </h5>

        <p class="text-muted mb-0" style="font-size: 0.9rem;">
          <%= current_user.username.presence || current_user.email %>
        </p>

      </div>
    </div>

  </div>

<!-- Action Buttons -->
<div class="bg-white rounded-bottom-6 px-4 py-3">
  <div class="d-flex gap-2">
    <div>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-danger-doggy text-white rounded-4 px-3" %>
    </div>
    <div>
      <%= link_to "Modifier mon profil",
            edit_user_registration_path,
            class: "btn btn-danger-doggy text-white rounded-4 px-3" %>
    </div>
  </div>
</div>

<br>
<!-- Dog(s) that you own -->
  <% @dogs.each do |dog| %>
    <div class="d-flex align-items-center gap-3 p-3">

      <!-- AVATAR CLIQUABLE -->
      <% if dog.avatar.attached? %>
        <%= link_to dog_path(dog) do %>
          <%= cl_image_tag dog.avatar.key,
                transformation: [
                  { width: 120, height: 120, crop: "thumb", gravity: "face", quality: "auto" }
                ],
                class: "rounded-circle object-fit-cover",
                style: "width: 120px; height: 120px; flex-shrink: 0; border: 4px solid #f86120;",
                alt: dog.name %>
        <% end %>
      <% else %>
        <%= link_to dog_path(dog) do %>
          <%= image_tag "dogs_pic.jpg",
                class: "rounded-circle object-fit-cover",
                style: "width: 120px; height: 120px; flex-shrink: 0; border: 4px solid #f86120;" %>
        <% end %>
      <% end %>

      <!-- NOM CLIQUABLE -->
      <h1 class="fw-bold mb-0">
        <%= link_to dog.name, dog_path(dog), class: "text-dark text-decoration-underline" %>
      </h1>

    </div>
  <% end %></div>
