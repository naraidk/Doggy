<div class="card border-light rounded-6 shadow-sm mb-3 mx-3">
    <div class="card-body p-1">
      <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <div class="d-flex align-items-center" style="min-width: 0;">

  </div>
      </div>

      <div class="border-light-subtle bg-white rounded-bottom-6 px-4 py-3">
        <div class="d-flex align-items-start gap-3">

          <!-- Avatar gauche -->
          <div class="flex-shrink-0">
            <%= link_to edit_avatar_dog_path(@dog), data: { turbo_frame: "avatar_panel" }, style: "cursor: pointer;" do %>
              <% if @dog.avatar.attached? %>
                <%= cl_image_tag @dog.avatar.key,
                  transformation: [
                    { width: 75, height: 75, crop: "thumb", gravity: "face", quality: "auto" }
                  ],
                  class: "rounded-circle object-fit-cover",
                  style: "width: 75px; height: 75px; border: 4px solid #f86120;",
                  alt: @dog.name %>
              <% else %>
                <%= image_tag "dogs_pic.jpg",
                  class: "rounded-circle object-fit-cover",
                  style: "width: 75px; height: 75px; border: 4px solid #f86120;" %>
              <% end %>
            <% end %>
          </div>

          <!-- Infos droite -->
          <div>
            <h1 class="fw-bold mb-1"><%= @dog.name %></h1>
            <p class="mb-0">
              <strong>Race :</strong> <%= @dog.breed || "Non renseigné" %><br>
              <strong>Sexe :</strong> <%= @dog.gender || "Non renseigné" %><br>
              <strong>Âge :</strong> <%= @dog.age || "Non renseigné" %> ans<br>
              <strong>Description :</strong> <%= @dog.description.presence || "Aucune description." %><br>
              <strong>Maître :</strong> <%= link_to "#{@dog.user.first_name} #{@dog.user.last_name}", dogs_path, style: "text-decoration: underline; color: black;" %>
            </p>
          </div>

        </div>
      </div>
       <div class="border-light-subtle bg-white rounded-bottom-6 px-4 py-2">
      <hr>
      <p>
        Messages :
        <%= @dog.messages.size || "Non renseigné" %><br>
        Events :
        <%= @dog.events.size || "Non renseigné" %><br>
        Events participants :
        <%= @dog.event_participants.size || "Non renseigné" %><br>
        Posts : <%= @dog.posts.size || "Non renseigné" %><br>
        Comments :
        <%= @dog.comments.size || "Non renseigné" %><br>
        Woufs :
        <%= @dog.woufs.size || "Non renseigné" %>
      </p>

       </div>
      <div class="d-flex justify-content-between gap-2 mt-1 px-4">

        <%= button_to "Discuter",
            conversations_path,
            method: :post,
            params: { dog_one_id: current_dog.id, dog_two_id: @dog.id },
            class: "btn btn-doggy text-white rounded-4 px-3" %>

        <%= link_to "Modifier", edit_dog_path(@dog), class: "btn btn-danger-doggy text-white rounded-4 px-3" %>

        <%= button_to "Supprimer",
            dog_path(@dog),
            method: :delete,
            data: {
              turbo_confirm: "Supprimer ce chien ?"
            },
            class: "btn btn-danger-doggy text-white rounded-4 px-3" %>

      </div>

      <hr>

            <div class="d-flex row my-1 px-4 mb-3">
        <% @photos.each do |post| %>
          <div class="col-4">
            <%= link_to post_path(post), data: { turbo_frame: "post_panel" } do %>
              <%= cl_image_tag post.image.key,
                    transformation: [
                      { width: 300, height: 300, crop: "fill", gravity: "auto", quality: "auto" }
                    ],
                    class: "w-100 rounded",
                    style: "aspect-ratio: 1/1; object-fit: cover;" %>
            <% end %>
          </div>
        <% end %>
      </div>
            </div>
    </div>
  </div>



</div>

<turbo-frame id="post_panel"></turbo-frame>
<turbo-frame id="avatar_panel"></turbo-frame>
