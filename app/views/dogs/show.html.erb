<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <!-- Infos du chien -->
      <div class="card mb-4">
        <div class="card-body">
          <h2 class="card-title"><%= @dog.name %></h2>
          <p class="text-muted mb-1">
            <i class="fa-solid fa-paw me-1"></i> Race : <strong><%= @dog.breed %></strong>
          </p>
          <p class="text-muted mb-1">
            <i class="fa-solid fa-cake-candles me-1"></i> Âge : <strong><%= @dog.age %> ans</strong>
          </p>
          <% if @dog.description.present? %>
            <p class="mt-3"><%= @dog.description %></p>
          <% end %>
        </div>
      </div>

      <!-- Bouton chatbot -->
      <%= button_to "💬 Demander à l'IA", dog_ai_chats_path(@dog),
          method: :post,
          class: "btn btn-outline-primary w-100" %>

    </div>
  </div>
</div>
