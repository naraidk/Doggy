<div class="card border-light rounded-6 shadow-sm mb-3 mx-3">

      <div class="border-light-subtle bg-white rounded-bottom-6 px-4 py-3">
        <div class="d-flex align-items-start gap-3">
          <div class="flex-shrink-0">
            <% if @dog.user == current_user %>
              <%= link_to edit_avatar_dog_path(@dog), data: { turbo_frame: "avatar_panel" }, style: "cursor: pointer;" do %>
                <% if @dog.avatar.attached? %>
                  <%= cl_image_tag @dog.avatar.key,
                    transformation: [
                      { width: 75, height: 75, crop: "thumb", gravity: "face", quality: "auto" }
                    ],
                    class: "rounded-circle object-fit-cover",
                    style: "width: 75px; height: 75px; border: 4px solid #f86120;",
                    alt: @dog.name %>
                <% else %>
                  <%= image_tag "dogs_pic.jpg",
                    class: "rounded-circle object-fit-cover",
                    style: "width: 75px; height: 75px; border: 4px solid #f86120;" %>
                <% end %>
              <% end %>
            <% else %>
              <% if @dog.avatar.attached? %>
                <%= cl_image_tag @dog.avatar.key,
                  transformation: [
                    { width: 75, height: 75, crop: "thumb", gravity: "face", quality: "auto" }
                  ],
                  class: "rounded-circle object-fit-cover",
                  style: "width: 75px; height: 75px; border: 4px solid #f86120;",
                  alt: @dog.name %>
              <% else %>
                <%= image_tag "dogs_pic.jpg",
                  class: "rounded-circle object-fit-cover",
                  style: "width: 75px; height: 75px; border: 4px solid #f86120;" %>
              <% end %>
            <% end %>
          </div>

          <div class="dog-profile-details flex-grow-1">
            <h1 class="fw-bold mb-2"><%= @dog.name %></h1>
            <div class="dog-detail-item mb-2">
              <strong>Race :</strong>
              <span><%= @dog.breed || "Non renseigné" %></span>
            </div>
            <div class="dog-detail-item mb-2">
              <strong>Sexe :</strong>
              <span><%= @dog.gender || "Non renseigné" %></span>
            </div>
            <div class="dog-detail-item mb-2">
              <strong>Âge :</strong>
              <span><%= @dog.age || "Non renseigné" %> ans</span>
            </div>
            <div class="dog-detail-item mb-2">
              <strong>Description :</strong>
              <span><%= @dog.description.presence || "Aucune description." %></span>
            </div>
            <div class="dog-detail-item">
              <strong>Maître :</strong>
              <span>
                <% if @dog.user == current_user %>
                  <%= link_to "#{@dog.user.first_name} #{@dog.user.last_name}", dogs_path, style: "text-decoration: underline; color: black;" %>
                <% else %>
                  <%= "#{@dog.user.first_name} #{@dog.user.last_name}" %>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>

  <%# Statistiques %>
  <div class="border-top border-light-subtle px-4 py-3">
    <div class="row text-center g-3">
      <div class="col-4">
        <div class="fw-bold text-doggy" style="font-family: 'DM Sans', sans-serif; font-size: 1.3rem; line-height: 1;"><%= @dog.posts.size %></div>
        <div class="text-muted mt-1" style="font-size: 0.9rem;"><i class="fa-solid fa-image"></i></div>
      </div>
      <div class="col-4">
        <div class="fw-bold text-doggy" style="font-family: 'DM Sans', sans-serif; font-size: 1.3rem; line-height: 1;"><%= @dog.events.size %></div>
        <div class="text-muted mt-1" style="font-size: 0.9rem;"><i class="fa-solid fa-calendar-days"></i></div>
      </div>
      <!-- <div class="col-4"> -->
        <!-- <div class="fw-bold text-doggy" style="font-family: 'DM Sans', sans-serif; font-size: 1.3rem; line-height: 1;"><%#= @dog.woufs.size %></div> -->
        <!-- <div class="text-muted mt-1" style="font-size: 0.9rem;"><i class="fa-solid fa-paw"></i></div> -->
      <!-- </div> -->
      <div class="col-4">
        <div class="fw-bold text-doggy" style="font-family: 'DM Sans', sans-serif; font-size: 1.3rem; line-height: 1;"><%= @dog.messages.size %></div>
        <div class="text-muted mt-1" style="font-size: 0.9rem;"><i class="fa-solid fa-comment-dots"></i></div>
      </div>
      <!-- <div class="col-4"> -->
        <!-- <div class="fw-bold text-doggy" style="font-family: 'DM Sans', sans-serif; font-size: 1.3rem; line-height: 1;"><%#= @dog.comments.size %></div> -->
        <!-- <div class="text-muted mt-1" style="font-size: 0.9rem;"><i class="fa-solid fa-comments"></i></div> -->
      <!-- </div> -->
      <!-- <div class="col-4"> -->
        <!-- <div class="fw-bold text-doggy" style="font-family: 'DM Sans', sans-serif; font-size: 1.3rem; line-height: 1;"><%#= @dog.event_participants.size %></div> -->
        <!-- <div class="text-muted mt-1" style="font-size: 0.9rem;"><i class="fa-solid fa-ticket"></i></div> -->
      <!-- </div> -->
    </div>
  </div>

  <%# Actions %>
  <div class="border-top border-light-subtle bg-white rounded-bottom-6 px-4 py-3">
    <div class="d-flex gap-2">
      <% if @dog.user != current_user %>
        <%= button_to "Discuter",
              conversations_path,
              method: :post,
              params: { dog_one_id: current_dog.id, dog_two_id: @dog.id },
              class: "btn btn-doggy text-white rounded-4 px-3 flex-fill" %>
      <% end %>
      <% if @dog.user == current_user %>
        <%= link_to "Modifier", edit_dog_path(@dog), class: "btn btn-danger-doggy text-white rounded-4 px-3 flex-fill" %>
        <%= button_to "Supprimer",
              dog_path(@dog),
              method: :delete,
              data: { turbo_confirm: "Supprimer ce chien ?" },
              form: { class: "flex-fill" },
              class: "btn btn-danger-doggy text-white rounded-4 px-3 w-100" %>
      <% end %>
    </div>
  </div>

</div>

<%# Galerie photos %>
<% if @photos.any? %>
  <div class="card border-light rounded-6 shadow-sm mb-3 mx-3">
    <div class="card-body px-3 py-3">
      <h6 class="fw-bold text-dark mb-3 px-1">Photos</h6>
      <div class="row g-2">
        <% @photos.each do |post| %>
          <div class="col-4">
            <%= link_to post_path(post), data: { turbo_frame: "post_panel" } do %>
              <%= cl_image_tag post.image.key,
                    transformation: [{ width: 300, height: 300, crop: "fill", gravity: "auto", quality: "auto" }],
                    class: "w-100 rounded-4",
                    style: "aspect-ratio: 1/1; object-fit: cover;" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<turbo-frame id="post_panel"></turbo-frame>
<turbo-frame id="avatar_panel"></turbo-frame>
