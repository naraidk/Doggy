<div class="card border-light rounded-6 shadow-sm mb-3 mx-3">
    <div class="card-body p-1">
      <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">

    <div class="d-flex align-items-center" style="min-width: 0;">

      <!-- User Profile -->
       <%= image_tag "user.svg",
        class: "rounded-circle me-3",
        style: "width: 56px; height: 56px; flex-shrink: 0; background-color: #eee; padding: 8px; object-fit: contain;" %>


      <!-- user info -->
      <div>
        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem; letter-spacing: -0.3px;">
          <%= [current_user.first_name, current_user.last_name].compact.join(" ") %>
        </h5>

        <p class="text-muted mb-0" style="font-size: 0.9rem;">
          <%= current_user.username.presence || current_user.email %>
        </p>

      </div>
    </div>

    <div>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-danger-doggy text-white rounded-4 px-3" %>
    </div>

  </div>
      <div class="d-flex justify-content-center align-items-center w-100 mt-2 mb-1">
        <%= link_to edit_avatar_dog_path(@dog), data: { turbo_frame: "avatar_panel" }, style: "cursor: pointer;" do %>
          <% if @dog.avatar.attached? %>
            <%= cl_image_tag @dog.avatar.key,
              transformation: [
                { width: 150, height: 150, crop: "thumb", gravity: "face", quality: "auto" }
              ],
              class: "rounded-circle object-fit-cover",
              style: "border: 7px solid #f86120;",
              alt: @dog.name %>
          <% else %>
            <%= image_tag "dogs_pic.jpg",
              class: "rounded-circle object-fit-cover",
              style: "width:100px;height:100px;border:7px solid #f86120;" %>
          <% end %>
        <% end %>
      </div>
      </div>

      <div class="border-light-subtle bg-white rounded-bottom-6 px-4 py-2">
    <h1 class="fw-bold">
    <%= @dog.name %>
    </h1>
      <p>
        <strong>Race :</strong>
        <%= @dog.breed || "Non renseigné" %><br>
                <strong>Sexe :</strong>
        <%= @dog.gender || "Non renseigné" %><br>
                <strong>Âge :</strong>
        <%= @dog.age || "Non renseigné" %> ans <br>
                <strong>Description :</strong>
        <%= @dog.description.presence || "Aucune description." %><br>
                <strong>Maître :</strong>
        <%= current_user.first_name %>
      </p>

      </div>
       <div class="border-light-subtle bg-white rounded-bottom-6 px-4 py-2">
      <hr>
      <p>
        Messages :
        <%= @dog.messages.size || "Non renseigné" %><br>
        Events :
        <%= @dog.events.size || "Non renseigné" %><br>
        Events participants :
        <%= @dog.event_participants.size || "Non renseigné" %><br>
        Posts : <%= @dog.posts.size || "Non renseigné" %><br>
        Comments :
        <%= @dog.comments.size || "Non renseigné" %><br>
        Woufs :
        <%= @dog.woufs.size || "Non renseigné" %>
      </p>

       </div>
      <div class="d-flex justify-content-between gap-2 mt-1 px-4">

        <%= button_to "Discuter",
            conversation_path(@dog),
            method: :post,
            class: "btn btn-doggy text-white rounded-4 px-3" %>

        <%= link_to "Modifier", edit_dog_path(@dog), class: "btn btn-danger-doggy text-white rounded-4 px-3" %>

        <%= button_to "Supprimer",
            dog_path(@dog),
            method: :delete,
            data: {
              turbo_confirm: "Supprimer ce chien ?"
            },
            class: "btn btn-danger-doggy text-white rounded-4 px-3" %>

      </div>

      <hr>

            <div class="d-flex row gap-2 my-1 px-4">
        <% @photos.each do |post| %>
          <div class="col-4">
            <%= link_to post_path(post), data: { turbo_frame: "post_panel" } do %>
              <%= cl_image_tag post.image.key,
                    transformation: [
                      { width: 300, height: 300, crop: "fill", gravity: "auto", quality: "auto" }
                    ],
                    class: "w-100 rounded",
                    style: "aspect-ratio: 1/1; object-fit: cover;" %>
            <% end %>
          </div>
        <% end %>
      </div>
            </div>
    </div>
  </div>



</div>

<turbo-frame id="post_panel"></turbo-frame>
<turbo-frame id="avatar_panel"></turbo-frame>
