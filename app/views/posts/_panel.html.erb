<turbo-frame id="post_panel">
  <div class="post-panel panel-responsive" data-controller="panel">

    <!-- HEADER -->
    <div class="panel-header d-flex align-items-center justify-content-between px-3 py-2">
      <button class="btn-close" data-action="click->panel#close"></button>
    </div>

    <!-- CONTENU SCROLLABLE -->
    <div class="panel-body">

      <!-- IMAGE -->
      <%= cl_image_tag post.image.key,
            transformation: [
              { width: 900, height: 900, crop: "fill", gravity: "auto", quality: "auto" }
            ],
            class: "post-image" %>

      <!-- INFOS -->
      <div class="px-3 mt-3">
        <div class="d-flex align-items-center mb-2">

          <strong class="text-doggy"><%= post.dog.name %></strong>
          <!-- <br> -->
          <span class="text-muted ms-2">
             il y a <%= time_ago_in_words(post.created_at) %></span>
        </div>

        <p><%= post.content %></p>

        <!-- WOUFS -->
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="text-muted"><%= post.woufs.count %> woufs</span>

        </div>

        <hr>

        <!-- COMMENTAIRES -->
        <span class="text-muted"><%= post.comments.count %> commentaires</span>
        <% post.comments.each do |comment| %>
          <div class="d-flex align-items-start mb-3">
            <% if comment.dog.avatar.attached? %>
              <%= cl_image_tag comment.dog.avatar.key,
                    transformation: [
                      { width: 28, height: 28, crop: "thumb", gravity: "face", quality: "auto" }
                    ],
                    class: "rounded-circle me-2",
                    style: "border: 2px solid #f86120;" %>
            <% end %>

            <div>
              <strong class="text-doggy"><%= comment.dog.name %></strong>
              <span><%= comment.content %></span>
            </div>
          </div>
        <% end %>
          <hr>
          <br>
        <!-- Delete post -->
          <div class="delete-container">
              <% if post.dog.user == current_user %>
                <%= button_to post_path(post),
                      method: :delete,
                      class: "delete-button text-doggy-danger fs-6",
                      form: { data: { turbo_confirm: "Es-tu sûr de vouloir supprimer ce post ?" } } do %>
                <i class="fa-solid fa-trash"></i>
                <% end %>
              <% end %>
          </div>
      </div>
    </div>

  </div>
</turbo-frame>
