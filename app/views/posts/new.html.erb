<h1>Nouveau post</h1>

<%= form_with model: @post, url: posts_path, local: true do |f| %>

  <%= f.label :dog_id, "En tant que:" %>
  <%= f.collection_select :dog_id, current_user.dogs, :id, :name, prompt: "chien(s)" %>
<br><br>
  <%= f.file_field :image, class: "image-upload" %>

<br><br>
  <%= f.text_area :content, class: "post-description" %>
<hr>
  <%= f.submit "Publier" %>

<% end %>
