<div class="container py-4 mb-5">
  <h1 class="text-center mb-4">Découvrir des chiens</h1>

  <% if @target_dog.present? %>

    <div class="d-flex justify-content-center align-items-center gap-3 mb-4">
      <!-- Current dog -->
      <div class="text-center">
        <% if current_dog.avatar.attached? %>
          <%= cl_image_tag current_dog.avatar.key,
                transformation: [{ width: 80, height: 80, crop: "thumb", gravity: "face", quality: "auto" }],
                class: "rounded-circle object-fit-cover",
                style: "width: 80px; height: 80px; border: 3px solid #f86120;" %>
        <% else %>
          <%= image_tag "dogs_pic.jpg", class: "rounded-circle object-fit-cover",
                style: "width: 80px; height: 80px; border: 3px solid #f86120;" %>
        <% end %>
        <p class="mt-1 mb-0 fw-semibold text-doggy" style="font-size: 0.85rem;"><%= current_dog.name %></p>
      </div>

      <!-- VS indicator -->
      <div class="text-center" style="font-size: 1.4rem;">🐾</div>

      <!-- Target dog -->
      <div class="text-center">
        <% if @target_dog.avatar.attached? %>
          <%= cl_image_tag @target_dog.avatar.key,
                transformation: [{ width: 80, height: 80, crop: "thumb", gravity: "face", quality: "auto" }],
                class: "rounded-circle object-fit-cover",
                style: "width: 80px; height: 80px; border: 3px solid #adb5bd;" %>
        <% else %>
          <%= image_tag "dogs_pic.jpg", class: "rounded-circle object-fit-cover",
                style: "width: 80px; height: 80px; border: 3px solid #adb5bd;" %>
        <% end %>
        <p class="mt-1 mb-0 fw-semibold text-muted" style="font-size: 0.85rem;"><%= @target_dog.name %></p>
      </div>
    </div>

    <div class="card shadow-sm text-center rounded-4">
      <div class="card-body">
        <h2><%= @target_dog.name %></h2>

        <p class="text-muted">
          <%= @target_dog.breed %> · <%= @target_dog.age %> ans
        </p>

        <p><%= @target_dog.description %></p>

       <div class="text-center my-4">
  <span class="badge bg-success fs-2 px-5 py-3 rounded-pill shadow">
    🐾 Compatibilité : <%= @score %>%
  </span>
</div>

        <div class="mt-3 text-start">
          <p><strong>Taille :</strong> <%= @target_dog.size %></p>
          <p><strong>Énergie :</strong> <%= @target_dog.energy_level %></p>
          <p><strong>Sociabilité canine :</strong> <%= @target_dog.canine_sociability %></p>
          <p><strong>Tempérament :</strong> <%= @target_dog.temperament %></p>
          <p><strong>Activité favorite :</strong> <%= @target_dog.favorite_activity %></p>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
  <%= button_to "Passer",
      swipes_path(target_dog_id: @target_dog.id, liked: false),
      method: :post,
      class: "btn btn-outline-secondary rounded-pill px-4" %>

  <%= button_to "Wouf 💖",
      swipes_path(target_dog_id: @target_dog.id, liked: true),
      method: :post,
      class: "btn btn-danger rounded-pill px-4" %>

  <%= button_to "Discuter",
      conversations_path(
        dog_one_id: current_user.dogs.first.id,
        dog_two_id: @target_dog.id
      ),
      method: :post,
      class: "btn btn-primary rounded-pill px-4" %>
</div>
      </div>
    </div>
  <% else %>
    <p class="text-center text-muted">
      Aucun chien à découvrir pour le moment.
    </p>
  <% end %>
</div>
