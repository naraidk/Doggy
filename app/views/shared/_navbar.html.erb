    <%= image_tag is_calendar_active ? "calendar_doggy.svg" : "calendar.svg", style: "width: 24px; height: 24px;" %>
  <% end %>

      <%= link_to conversations_path, class: "nav-icon", title: "Messagerie" do %>
      <%= image_tag current_page?(conversations_path) ? "messages_doggy.svg" : "messages.svg", style: "width: 24px; height: 24px;" %>
      <% end %>

