<nav class="bottom-nav border-top bg-white d-flex justify-content-around align-items-center fixed-bottom py-3">

      <%= link_to root_path, class: "nav-icon", title: "Accueil" do %>
      <%= image_tag current_page?(root_path) ? "home_doggy.svg" : "home.svg", style: "width: 24px; height: 24px;" %>
      <% end %>

      <%= link_to swipes_path, class: "nav-icon", title: "Matching" do %>
       <%= image_tag current_page?(swipes_path) ? "doggy_heart.svg" : "doggy_heart_black.svg", style: "width: 24px; height: 24px;" %>
  <% end %>

      <%= link_to events_path, class: "nav-icon", title: "Planning" do %>
    <%# L'icône sera orange si on est sur les événements OU sur la carte %>
