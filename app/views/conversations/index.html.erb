<% @conversations.each do |conversation| %>
  <%= link_to conversation_path(conversation), class: "text-decoration-none" do %>
    <div class="card border-light rounded-6 shadow-sm mb-3 mx-3" style="background-color: #f8f9fa;">
      <div class="card-body d-flex justify-content-between align-items-center px-4 py-3">
        <p class="text-muted text-truncate mb-0 me-3">
          <%= conversation.messages.last&.content&.truncate(40) || "Aucun message" %>
        </p>
        <span class="badge py-2 px-3 rounded-3" style="background-color: #FF5D24; color: white; font-size: 0.85rem;">
          <%= conversation.other_dog(current_user).name %>

        </span>
      </div>
    </div>
  <% end %>
<% end %>

<% if @ai_chats.empty? && @conversations.empty? %>
  <p class="text-muted text-center mt-5">Aucune conversation pour l'instant.</p>
<% end %>
