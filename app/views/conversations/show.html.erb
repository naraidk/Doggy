<%= turbo_stream_from "conversation_#{@conversation.id}_messages" %>

<% other_dog = @conversation.dog_one == current_user.dogs.first ? @conversation.dog_two : @conversation.dog_one %>

<div class="chat" data-controller="chat-scroll">
  <div class="chat-header text-center">
    <% if other_dog.avatar.attached? %>
      <%= cl_image_tag other_dog.avatar.key,
            transformation: [{ width: 70, height: 70, crop: "thumb", gravity: "face", quality: "auto" }],
            alt: other_dog.name,
            class: "rounded-circle object-fit-cover",
            style: "width:70px;height:70px;border:3px solid #FF5D24;" %>
    <% else %>
      <%= image_tag "dogs_pic.jpg",
            alt: other_dog.name,
            class: "rounded-circle object-fit-cover",
            style: "width:70px;height:70px;border:3px solid #FF5D24;" %>
    <% end %>
    <h5 class="mt-2 mb-0 fw-bold"><%= other_dog.name %></h5>
  </div>

  <div id="messages"
       class="messages"
       data-chat-scroll-target="messages">
    <% @conversation.messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>
  </div>

  <%= simple_form_for [@conversation, @message],
    html: {
      class: "message-form",
      data: {
        controller: "reset-form",
        action: "turbo:submit-end->reset-form#reset"
      }
    } do |f| %>

    <%= f.input :dog_id,
      as: :hidden,
      wrapper: false,
      input_html: { value: current_user.dogs.first.id } %>

    <%= f.text_field :content,
      placeholder: "Write as #{current_user.dogs.first.name}",
      class: "message-text-field" %>

    <%= f.submit " → ", class: "message-submit-btn fs-1" %>
  <% end %>
</div>
