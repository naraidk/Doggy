<%= turbo_stream_from "conversation_#{@conversation.id}_messages" %>

<div class="chat" data-controller="chat-scroll">
  <h1>
    Chat between
    <%= @conversation.dog_one.name %>
    and
    <%= @conversation.dog_two.name %>
  </h1>

  <div id="messages"
       class="messages"
       data-chat-scroll-target="messages">
    <% @conversation.messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>
  </div>

  <%= simple_form_for [@conversation, @message],
    html: {
      class: "message-form",
      data: {
        controller: "reset-form",
        action: "turbo:submit-end->reset-form#reset"
      }
    } do |f| %>

    <%= f.input :dog_id,
      as: :hidden,
      wrapper: false,
      input_html: { value: current_user.dogs.first.id } %>

    <%= f.text_field :content,
      placeholder: "Write as #{current_user.dogs.first.name}",
      class: "message-text-field" %>

    <%= f.submit "Envoi", class: "message-submit-btn" %>
  <% end %>
</div>
