<div class="comments-panel" data-controller="comments" data-comments-post-id-value="<%= @post.id %>">
  <div class="panel-header d-flex justify-content-between px-4 pt-2">
    <span class="fw-light fs-6">Commentaires sur <strong><%= @post.dog.name %></strong></span>
    <button class="close-panel" data-action="click->comments#close">✕</button>
  </div>

  <div class="panel-body">

    <div class="post">

      <% @comments.each do |comment| %>
        <div class="comment" id="<%= dom_id(comment) %>">

              <!-- Avatar du chien -->
              <div class="d-flex align-items-start gap-2">

                <%= link_to dog_path(comment.dog), data: { turbo_frame: "_top" } do %>
                  <% if comment.dog.avatar.attached? %>
                    <%= cl_image_tag comment.dog.avatar.key,
                          transformation: [
                            { width: 28, height: 28, crop: "thumb", gravity: "face", quality: "auto" }
                          ],
                          class: "rounded-circle object-fit-cover align-self-start",
                          style: "width: 28px; height: 28px; border: 2px solid #f86120;" %>
                  <% else %>
                    <%= image_tag "dogs_pic.jpg",
                          class: "rounded-circle object-fit-cover align-self-start",
                          style: "width: 28px; height: 28px; border: 2px solid #f86120;" %>
                  <% end %>
                <% end %>

                <span class="comment-text">
                  <%= link_to dog_path(comment.dog), data: { turbo_frame: "_top" }, class: "text-decoration-underline text-dark fw-bold" do %>
                    <%= comment.dog.name %>
                  <% end %>
                  : <%= comment.content %>
                </span>

              </div>


          <% if comment.dog == current_dog %>
            <%= button_to [@post, comment],
                method: :delete,
                class: "delete-comment-btn text-doggy-danger",
                data: { turbo_confirm: "Supprimer ce commentaire ?" } do %>
              <i class="fa-solid fa-trash"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>

    </div>

    <div class="panel-footer">
      <%= form_with model: [@post, Comment.new] do |f| %>

          <!-- Avatar dog -->
          <% if current_user.dogs.count > 1 %>
            <div class="d-flex gap-2 mb-2">

              <% current_user.dogs.each do |dog| %>
                <label class="d-flex align-items-center gap-2 p-2 border rounded-3 dog-choice"
                      style="cursor: pointer;">

                  <%= radio_button_tag :dog_id, dog.id, false, class: "form-check-input me-1" %>

                  <% if dog.avatar.attached? %>
                    <%= cl_image_tag dog.avatar.key,
                          transformation: [
                            { width: 28, height: 28, crop: "thumb", gravity: "face", quality: "auto" }
                          ],
                          class: "rounded-circle object-fit-cover",
                          style: "width: 28px; height: 28px; border: 2px solid #f86120;" %>
                  <% else %>
                    <%= image_tag "dogs_pic.jpg",
                          class: "rounded-circle object-fit-cover",
                          style: "width: 28px; height: 28px; border: 2px solid #f86120;" %>
                  <% end %>

                  <span class="small fw-bold"><%= dog.name %></span>

                </label>
              <% end %>

            </div>
          <% else %>
            <%= hidden_field_tag :dog_id, current_dog.id %>
          <% end %>


        <div class="comment-form">
          <%= f.text_area :content, placeholder: "Ajouter ton commentaire…", class: "comment-input" %>
          <%= f.submit "Publier", class: "comment-submit" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
